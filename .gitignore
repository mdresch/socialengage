

#Ignore vscode AI rules
.github\instructions\codacy.instructions.md

# Environment / secrets — never commit real values (docs/ai-roles' AI-agent API keys, etc.)
.env
.env.*
!.env.example
!.env.*.example

# Python bytecode
__pycache__/
*.pyc
*.pyo

# docs/ai-roles/ tooling dependencies (@google/genai etc.) — reinstall via npm install
node_modules/

# Claude Code — personal, local permission overrides (not team-wide config)
.claude/settings.local.json

# Jest per-process test database context files
.jest-test-db-*.json
