{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-git-hooks-installed.cjs",
            "timeout": 15,
            "statusMessage": "Verifying git hooks are installed..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/enforce-contract-first.cjs",
            "timeout": 10,
            "statusMessage": "Checking contract-first policy..."
          }
        ]
      }
    ]
  }
}
