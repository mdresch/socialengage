# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored at the repo root (.gitignore: .env / .env.* / !.env.example)
# — never commit real values.

# social-listening-core's REST base URL. Server-side only (no NEXT_PUBLIC_ prefix —
# core-client.ts must stay server-only so the bearer token it attaches, per Story 6.1/
# ADR-0036, is never reachable from a browser bundle).
CORE_API_BASE_URL=http://localhost:3001

# Microsoft Entra External ID (Story 6.1 / ADR-0036) — the same real tenant Story 5.6
# provisioned for social-listening-core. Copy ENTRA_TENANT_ID/ENTRA_TENANT_SUBDOMAIN
# straight from social-listening-core/.env — same tenant, not a second one.
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=

# social-listening-admin's own app registration — a confidential Web client
# (Authorization Code + PKCE, exact-match redirect URI per ADR-0036 §3). Distinct
# from social-listening-core's own app registration/API resource.
ENTRA_ADMIN_CLIENT_ID=
ENTRA_ADMIN_CLIENT_SECRET=
ENTRA_ADMIN_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Session cookie encryption key (ADR-0036 §1) — real entropy, not a human-chosen
# passphrase. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# A real, dedicated test user for the contract test's own scripted sign-in — never
# reuse social-listening-core's ENTRA_TEST_TARGET_USER_ID (Story 5.7/5.8's break-glass
# tests reset that user's password as part of their own runs).
ENTRA_ADMIN_TEST_USER_EMAIL=
ENTRA_ADMIN_TEST_USER_PASSWORD=

# Facebook OAuth connect flow (Story 6.23 / ADR-0059). FACEBOOK_APP_ID is public,
# non-secret (the same category as any OAuth client_id) — copy it from
# social-listening-core/.env's own FACEBOOK_APP_ID (same Meta App registration).
# The app secret stays social-listening-core-side only; this repo never needs it.
FACEBOOK_APP_ID=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/facebook/oauth/callback
