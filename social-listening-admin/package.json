{
  "name": "social-listening-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Social Listening / Insights admin UI. Talks to social-listening-core exclusively through its REST API; never accesses the database directly (ADR-0001). Independently deployable from social-listening-core.",
  "scripts": {
    "dev": "next dev -p 3000 -H socialengage.test --experimental-https",
    "dev:https": "next dev -p 3000 -H socialengage.test --experimental-https",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "jest",
    "test:contracts": "jest contracts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.5.4",
    "dotenv": "17.4.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "30.4.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "undici": "^8.10.0"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "cobe": "^2.0.1",
    "jose": "5.10.0",
    "leaflet": "^1.9.4",
    "next": "16.3.0",
    "openid-client": "6.8.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1"
  }
