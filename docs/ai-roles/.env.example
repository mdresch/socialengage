# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored at the repo root — never commit real values.

# Mistral API key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# The Mistral-hosted agent ID for the Engineering Pragmatism Reviewer role
# (docs/ai-roles/engineering-pragmatism-reviewer.md — NOT the Data Privacy & Sovereignty
# Reviewer, which stays on Ollama specifically because it must never leave local hardware).
#
# Create/configure this agent in Mistral's Agent Builder using that file's "Prompt block"
# as its system instructions, then paste the resulting agent_id here.
# Format: ag_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_ENGINEERING_PRAGMATISM_AGENT_ID=

# Optional — defaults to 1 if unset.
MISTRAL_ENGINEERING_PRAGMATISM_AGENT_VERSION=1

# The Mistral-hosted agent ID for the Product & Market-Fit Reviewer role
# (docs/ai-roles/product-market-reviewer.md — reassigned from OpenAI to Mistral 2026-07-31,
# since OpenAI API access wasn't available on Menno's free-tier account). A second, separately
# configured Mistral agent from the one above — same account, different agent_id and persona.
#
# Create/configure this agent in Mistral's Agent Builder using that file's "Prompt block"
# as its system instructions, then paste the resulting agent_id here.
MISTRAL_PRODUCT_MARKET_FIT_AGENT_ID=

# Optional — defaults to 1 if unset.
MISTRAL_PRODUCT_MARKET_FIT_AGENT_VERSION=1

# Gemini API key, for the Security & Architecture Reviewer
# (docs/ai-roles/security-architecture-reviewer.md). Unlike Mistral, no persistent hosted
# agent object is used here — invoke-gemini-agent.mjs sends the charter's system instructions
# fresh on every call, so no agent ID is needed, just the key.
GEMINI_API_KEY=

# Optional — defaults to models/gemini-3.5-flash if unset.
GEMINI_SECURITY_REVIEWER_MODEL=

# Azure AI Foundry endpoint + key, for the Legal & Compliance Reviewer
# (docs/ai-roles/legal-compliance-reviewer.md — OpenAI's gpt-5.2, deployed via Azure AI
# Foundry in Sweden Central; provisioned 2026-08-05, real resource, not yet wired to a script).
# Never write the real endpoint URL or key into any committed file — this .env.example holds
# placeholders only, same discipline as MISTRAL_API_KEY/GEMINI_API_KEY above.
# Endpoint format: https://<your-resource-name>.services.ai.azure.com/openai/v1/responses
AZURE_AI_FOUNDRY_LEGAL_COMPLIANCE_ENDPOINT=
AZURE_AI_FOUNDRY_LEGAL_COMPLIANCE_API_KEY=

# Optional — defaults to gpt-5.2 if unset (fall back to the gpt-5 family if gpt-5.2 isn't
# actually deployed under this resource — see the charter's own caveat).
AZURE_AI_FOUNDRY_LEGAL_COMPLIANCE_MODEL=gpt-5.2

# Azure AI Foundry PROJECT config, for the Product & Market-Fit Reviewer's own Prompt Agent
# (docs/ai-roles/product-market-reviewer.md — added 2026-08-06 as a second backend alongside
# Mistral, specifically because Mistral has a real, recurring capacity/usage-limit constraint
# under load — see that charter's own "Assigned model" note). Invoked via
# invoke-azure-foundry-agent.mjs, which is a genuinely DIFFERENT pattern from
# AZURE_AI_FOUNDRY_LEGAL_COMPLIANCE_* above: this targets a real, portal-authored Foundry
# Prompt Agent (created in the Foundry portal, https://ai.azure.com, referenced by name +
# version), not a raw model deployment called with instructions/input on every request.
# Auth is Microsoft Entra ID (DefaultAzureCredential, i.e. `az login` locally) — there is
# deliberately NO API key var here; a Prompt Agent isn't reached with a static key the way the
# Legal & Compliance Reviewer's raw model endpoint is.
# Never write the real project endpoint into any committed file — this .env.example holds
# placeholders only, same discipline as every other credential above.
# Project endpoint format: https://<your-resource-name>.services.ai.azure.com/api/projects/<your-project-name>
# (NOT the .../openai/v1/responses shape used above — that's the raw-model endpoint, a
# different Foundry surface than the project/agent endpoint this SDK call targets.)
AZURE_AI_FOUNDRY_PRODUCT_MARKET_FIT_PROJECT_ENDPOINT=

# The exact name and version of the Prompt Agent as created in the Foundry portal — find both
# in that agent's own "Code" sample tab (https://ai.azure.com), or the agent list itself.
AZURE_AI_FOUNDRY_PRODUCT_MARKET_FIT_AGENT_NAME=ProductMarketFitReviewer
AZURE_AI_FOUNDRY_PRODUCT_MARKET_FIT_AGENT_VERSION=

# Azure AI Foundry PROJECT config, for the Engineering Pragmatism Reviewer's own Prompt Agent
# (docs/ai-roles/engineering-pragmatism-reviewer.md — added 2026-08-06, alongside the existing
# Mistral path). Same pattern/caveats as AZURE_AI_FOUNDRY_PRODUCT_MARKET_FIT_* above — no API
# key, project endpoint format is .../api/projects/<project-name>.
AZURE_AI_FOUNDRY_ENGINEERING_PRAGMATISM_PROJECT_ENDPOINT=
AZURE_AI_FOUNDRY_ENGINEERING_PRAGMATISM_AGENT_NAME=engineering-pragmatism-reviewer
AZURE_AI_FOUNDRY_ENGINEERING_PRAGMATISM_AGENT_VERSION=

# Azure AI Foundry PROJECT config, for the Legal & Compliance Reviewer's own Prompt Agent
# (docs/ai-roles/legal-compliance-reviewer.md — added 2026-08-06; supersedes the raw-model-
# endpoint vars above, AZURE_AI_FOUNDRY_LEGAL_COMPLIANCE_ENDPOINT/_API_KEY/_MODEL, as this
# role's real, working invocation path — those are left in place, not deleted). Same
# pattern/caveats as AZURE_AI_FOUNDRY_PRODUCT_MARKET_FIT_* above — no API key, project endpoint
# format is .../api/projects/<project-name>. Reuses the AZURE_AI_FOUNDRY_LEGAL_COMPLIANCE_
# prefix (no collision — the suffixes below are new/distinct from the raw-endpoint ones above).
AZURE_AI_FOUNDRY_LEGAL_COMPLIANCE_PROJECT_ENDPOINT=
AZURE_AI_FOUNDRY_LEGAL_COMPLIANCE_AGENT_NAME=LegalComplianceReviewer
AZURE_AI_FOUNDRY_LEGAL_COMPLIANCE_AGENT_VERSION=

# Data Privacy & Sovereignty Reviewer's real, portal-authored Foundry Prompt Agent
# (docs/ai-roles/data-privacy-sovereignty-reviewer.md — added 2026-08-06, replacing
# invoke-ollama-agent.cjs as this role's primary automation path after repeated real
# "fetch failed" errors under load; local Ollama itself stayed reachable via /api/tags
# throughout, so this looks like the local model crashing/OOMing mid-generation, not a
# config issue). Same pattern/caveats as AZURE_AI_FOUNDRY_PRODUCT_MARKET_FIT_* above.
AZURE_AI_FOUNDRY_DATA_PRIVACY_SOVEREIGNTY_PROJECT_ENDPOINT=
AZURE_AI_FOUNDRY_DATA_PRIVACY_SOVEREIGNTY_AGENT_NAME=data-privacy-sovereignty-reviewer
AZURE_AI_FOUNDRY_DATA_PRIVACY_SOVEREIGNTY_AGENT_VERSION=

# Data Sovereignty & Privacy Regulation Reviewer's real, portal-authored Foundry Prompt
# Agent (docs/ai-roles/data-sovereignty-privacy-regulation-reviewer.md — added 2026-08-06,
# same reason as AZURE_AI_FOUNDRY_DATA_PRIVACY_SOVEREIGNTY_* above; distinct charter/role
# from that one, not a duplicate). AGENT_NAME not yet confirmed by Menno.
AZURE_AI_FOUNDRY_DATA_SOVEREIGNTY_PRIVACY_REGULATION_PROJECT_ENDPOINT=
AZURE_AI_FOUNDRY_DATA_SOVEREIGNTY_PRIVACY_REGULATION_AGENT_NAME=
AZURE_AI_FOUNDRY_DATA_SOVEREIGNTY_PRIVACY_REGULATION_AGENT_VERSION=

# Ollama model tag for the Data Sovereignty & Privacy Regulation Reviewer
# (docs/ai-roles/data-sovereignty-privacy-regulation-reviewer.md — local only, no key needed).
# Distinct from the Data Privacy & Sovereignty Reviewer's own model default above (qwen2.5:0.5b) —
# confirm the exact tag with `ollama list` before relying on it; must not be a `:cloud`-suffixed
# model (see invoke-ollama-agent.cjs's own hard rule).
OLLAMA_SOVEREIGNTY_REVIEWER_MODEL=qwen3.5:9b
