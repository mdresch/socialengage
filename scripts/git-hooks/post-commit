#!/usr/bin/env sh

# Queues every commit for three separate, independent reviews — never blocking (the commit
# has already succeeded by the time this runs), never an API call (just a fast local
# file append). None of the Ideal Manager, Documentation Steward, or Learning & Development
# Writer has a standalone API-invocation script the way the external reviewers do — all three
# are Claude Code-native subagents, so nothing can actually run any of these reviews from a
# plain shell hook. This hook only leaves markers; a Claude Code session working in this repo
# checks each queue file and runs the matching review when an entry is present, per each
# agent's own instructions (.claude/agents/ideal-manager.md,
# .claude/agents/documentation-steward.md, .claude/agents/learning-development-writer.md).
#
# Three separate queue files, not one shared one: the Manager's job (workload/priority/
# decision triage), the Steward's job (internal traceability/staleness audit, including the
# PM docs as of 2026-08-06), and the Writer's job (added 2026-08-06 — keeping the three
# end-user-facing manuals under docs/manuals/ in sync with what's actually shipped) are
# different enough that conflating their "Status"/resolution semantics into one file would be
# more confusing than three small, single-purpose ones.
#
# Post-commit, not pre-commit: pre-commit runs before the commit object exists, so
# there is no stable hash yet to queue a review against.

HASH=$(git rev-parse HEAD)
SHORT_HASH=$(git rev-parse --short HEAD)
SUBJECT=$(git log -1 --format=%s)
FILES=$(git diff-tree --no-commit-id --name-only -r "$HASH" | tr '\n' ',' | sed 's/,/, /g' | sed 's/, $//')
DATE=$(date -u +%Y-%m-%d)

# Skip time-tracking's own maintenance commits (avoid a self-referential loop) and
# time-tracking.md-only changes, mirroring that file's own documented "skipped
# scenarios" convention.
TIME_TRACKING_FILE="docs/time-tracking.md"
ONLY_TOUCHES_TIME_TRACKING=$(echo "$FILES" | grep -vE "^${TIME_TRACKING_FILE}$" || true)
if [ -z "$ONLY_TOUCHES_TIME_TRACKING" ] && [ -n "$FILES" ]; then
  SKIP_TIME_LOG=1
else
  SKIP_TIME_LOG=0
fi

# 2026-08-20 — Documentation Steward: found live, not theorized. This hook's own
# "chore: post-commit hook outputs for X" commits (their entire diff is time-tracking.md
# plus the three queue files below, nothing else) were themselves being re-queued for
# review on every commit, with no terminating condition — the exact self-referential
# loop the time-tracking guard above already exists to prevent for that one file, never
# extended to these three. A session committing its own hook output would see a fresh,
# unrelated diff appear immediately after every single commit, forever. Applying the
# same guard here, generalized to the fixed bookkeeping fileset a pure hook-output
# commit touches.
BOOKKEEPING_FILES=" docs/time-tracking.md docs/management/pending-manager-reviews.md docs/pending-documentation-steward-reviews.md docs/pending-learning-development-reviews.md "
ONLY_TOUCHES_BOOKKEEPING=1
if [ -z "$FILES" ]; then
  ONLY_TOUCHES_BOOKKEEPING=0
else
  OLD_IFS="$IFS"
  IFS=','
  for f in $FILES; do
    f=$(echo "$f" | sed 's/^ *//;s/ *$//')
    case "$BOOKKEEPING_FILES" in
      *" $f "*) ;;
      *) ONLY_TOUCHES_BOOKKEEPING=0 ;;
    esac
  done
  IFS="$OLD_IFS"
fi

if [ "$SKIP_TIME_LOG" -eq 0 ] && [ -f "$TIME_TRACKING_FILE" ]; then
  # Auto-derived, never interactive: 2026-08-06 addition, replacing this file's own
  # stale claim of an interactive pre-commit prompt (never actually built — see
  # docs/time-tracking.md's own corrected mechanism section). An interactive prompt
  # in a hook would hang or fail on every commit this session makes on Menno's
  # behalf via tool calls (no TTY attached) — auto-deriving from the commit's own
  # message works identically whether a human or Claude Code committed.
  case "$SUBJECT" in
    "Implement Story"*) ACTIVITY="Implementation" ;;
    "Heal "*|"Fix "*) ACTIVITY="Debugging" ;;
    "Accept ADR"*|"Draft ADR"*|"Update"*ADR*) ACTIVITY="Design" ;;
    "Log "*) ACTIVITY="Documentation" ;;
    *[Rr]eview*) ACTIVITY="Review" ;;
    *hook*|*[Ii]nfrastructure*|*[Ss]cript*) ACTIVITY="Infrastructure" ;;
    *) ACTIVITY="Documentation" ;;
  esac

  STORY_ADR=$(echo "$SUBJECT" | grep -oE "(Story [0-9]+\.[0-9]+|ADR-[0-9]+)" | head -1)
  [ -z "$STORY_ADR" ] && STORY_ADR="—"

  # Record commit time (HH:MM) as a day-timeline marker — not wall-clock work time.
  COMMIT_TIME=$(git log -1 --format=%ci HEAD | cut -c12-16)

  NEW_ROW=$(printf '| %s | %s | — | — | %s | %s | %s (%s) |' \
    "$DATE" "$COMMIT_TIME" "$ACTIVITY" "$STORY_ADR" "$SUBJECT" "$SHORT_HASH")

  # A plain `>>` would append at end-of-file, after every other section and the
  # footer — the row has to land inside the actual log table, directly under its
  # own header-separator row, not just anywhere in the file.
  TMP_FILE="${TIME_TRACKING_FILE}.tmp"
  awk -v newrow="$NEW_ROW" '
    { print }
    /^\|------\|------------\|----------\|----------------\|----------\|-----------\|-------\|$/ && !inserted {
      print newrow
      inserted = 1
    }
  ' "$TIME_TRACKING_FILE" > "$TMP_FILE" && mv "$TMP_FILE" "$TIME_TRACKING_FILE"
fi

queue_commit() {
  QUEUE_FILE="$1"
  BOOTSTRAP_TITLE="$2"
  BOOTSTRAP_INTRO="$3"
  mkdir -p "$(dirname "$QUEUE_FILE")"

  if [ ! -f "$QUEUE_FILE" ]; then
    {
      echo "# ${BOOTSTRAP_TITLE}"
      echo ""
      echo "${BOOTSTRAP_INTRO}"
      echo ""
      echo "---"
      echo ""
    } > "$QUEUE_FILE"
  fi

  {
    echo "## ${DATE} — ${SHORT_HASH} — ${SUBJECT}"
    echo ""
    echo "- **Full commit:** \`${HASH}\`"
    echo "- **Files touched:** ${FILES}"
    echo "- **Status:** Pending review"
    echo ""
  } >> "$QUEUE_FILE"
}

if [ "$ONLY_TOUCHES_BOOKKEEPING" -eq 0 ]; then
  queue_commit \
    "docs/management/pending-manager-reviews.md" \
    "Pending Manager Reviews" \
    "**Queued by:** \`scripts/git-hooks/post-commit\`, one entry per commit, automatically, non-blocking. **Reviewed by:** the Ideal Manager (\`.claude/agents/ideal-manager.md\`) whenever a Claude Code session is actively working in this repo and checks this file — not a live daemon, not guaranteed same-day. Append-only, same discipline as \`docs/implementation-log.md\`: a reviewed entry gets struck through with a dated resolution note pointing to \`docs/management/manager-register.md\`'s matching finding, never deleted."

  queue_commit \
    "docs/pending-documentation-steward-reviews.md" \
    "Pending Documentation Steward Reviews" \
    "**Queued by:** \`scripts/git-hooks/post-commit\`, one entry per commit, automatically, non-blocking. **Reviewed by:** the Documentation Steward (\`.claude/agents/documentation-steward.md\`) whenever a Claude Code session is actively working in this repo and checks this file — not a live daemon, not guaranteed same-day. Append-only, same discipline as \`docs/implementation-log.md\`: a reviewed entry gets struck through with a dated resolution note, never deleted. The Steward may edit stale docs directly, but never commits its own changes — a human commit is the approval gate; an entry is resolved only once its corrections are actually committed."

  queue_commit \
    "docs/pending-learning-development-reviews.md" \
    "Pending Learning & Development Reviews" \
    "**Queued by:** \`scripts/git-hooks/post-commit\`, one entry per commit, automatically, non-blocking. **Reviewed by:** the Learning & Development Writer (\`.claude/agents/learning-development-writer.md\`) whenever a Claude Code session is actively working in this repo and checks this file — not a live daemon, not guaranteed same-day. Append-only, same discipline as \`docs/implementation-log.md\`: a reviewed entry gets struck through with a dated resolution note, never deleted. The Writer may edit the three manuals under docs/manuals/ directly, but never commits its own changes — a human commit is the approval gate; an entry is resolved only once any resulting manual edit is actually committed. Most commits resolve with 'no user-facing change' — a legitimate outcome, not a non-answer."
fi

exit 0
