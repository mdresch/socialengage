{
  "name": "social-listening-core",
  "version": "0.1.0",
  "private": true,
  "description": "Social Listening / Insights backend: connector framework, ingestion, normalization, enrichment, storage, event publishing, and the REST API (ADR-0001). Independently deployable from social-listening-admin.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "ts-node src/http/server.ts",
    "dev": "npm run db:dev:migrate && npm run dev:server",
    "dev:server": "node scripts/withDevEnv.js ts-node src/http/server.ts",
    "test": "jest",
    "test:contracts": "jest contracts",
    "typecheck": "tsc --noEmit",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:dev:reset": "docker compose -f docker-compose.dev.yml down -v",
    "db:dev:migrate": "node scripts/withDevEnv.js ts-node src/db/migrate.ts",
    "rag:backfill": "node scripts/withDevEnv.js ts-node src/rag/backfill.ts"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "@types/turndown": "5.0.6",
    "dotenv": "17.4.2",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@azure/keyvault-keys": "4.10.2",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.33.0",
    "express": "5.2.1",
    "jose": "^5.10.0",
    "pg": "8.22.0",
    "sanitize-html": "2.17.6",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "overrides": {
    "htmlparser2": "9.1.0"
  }
}
