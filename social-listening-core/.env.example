# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored at the repo root (.gitignore: .env / .env.* / !.env.example)
# — never commit real values. Loaded via dotenv in jest.global-setup.js.

# GNews API key (Story 2.7 / ADR-0026) — free "Essential" plan, no credit card:
# https://gnews.io. Used by the RSS/News connector's contract test to poll
# GNews's real Search endpoint (authMode: 'api_key' — the connector's own
# credential, per ADR-0027 never SocialEngage's).
GNEWS_API_KEY=

# Microsoft Entra External ID (Story 5.6 / ADR-0029) — real tenant, not a mock.
# Provisioned 2026-08-03: getsocialengage.onmicrosoft.com. ENTRA_TENANT_ID/
# ENTRA_API_APP_ID identify the real tenant/API resource the contract test's
# JWKS/issuer checks run against. ENTRA_TEST_CLIENT_ID/SECRET are a separate,
# test-only app registration (client_credentials grant) used solely to mint
# real tokens for the contract test — never a production auth path.
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_API_APP_ID=
ENTRA_TEST_CLIENT_ID=
ENTRA_TEST_CLIENT_SECRET=

# Break-glass credential reset (Story 5.7 / ADR-0030 §3) — two separate
# service principals, neither able to self-elevate (see
# .claude/skills/platform-admin-access/SKILL.md for why).
ENTRA_ELEVATOR_CLIENT_ID=
ENTRA_ELEVATOR_CLIENT_SECRET=
ENTRA_RESETTER_CLIENT_ID=
ENTRA_RESETTER_CLIENT_SECRET=
ENTRA_RESETTER_SP_OBJECT_ID=
ENTRA_USER_ADMINISTRATOR_ROLE_ID=
ENTRA_AUTHENTICATION_ADMINISTRATOR_ROLE_ID=
ENTRA_TEST_TARGET_USER_ID=
